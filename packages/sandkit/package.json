{
  "name": "sandkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./core/*": "./src/core/*",
    "./adapters/*": "./src/adapters/*",
    "./drivers/*": "./src/drivers/*",
    "./policies/*": "./src/policies/*",
    "./schema/*": "./src/schema/*",
    "./cli/*": "./src/cli/*"
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@vercel/sandbox": "1.8.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
