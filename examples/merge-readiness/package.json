{
  "name": "merge-readiness",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "mkdir -p data && drizzle-kit migrate --config drizzle.config.ts",
    "db:reset": "rm -f data/merge-readiness.sqlite && bun run db:migrate",
    "setup": "bun run db:reset"
  },
  "dependencies": {
    "@giselles-ai/sandkit": "latest",
    "@libsql/client": "^0.15.15",
    "drizzle-orm": "0.45.1",
    "next": "16.1.7",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "0.31.10",
    "typescript": "5.8.3"
  }
}
